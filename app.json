{
  "expo": {
    "name": "EscrowLock Gold",
    "slug": "escrowlock-gold",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app-icon.jpg",
    "scheme": "escrowlockgold",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0F7A4A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./app-icon.jpg",
      "bundleIdentifier": "com.escrowlockgold.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app-icon.jpg",
        "backgroundColor": "#0F7A4A"
      },
      "package": "com.escrowlockgold.app",
      "permissions": []
    },
    "web": {
      "favicon": "./app-icon.jpg"
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
